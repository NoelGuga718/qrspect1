# Optional Firebase web configuration. Firebase web API keys are public identifiers,
# not server secrets. Restrict them in Google Cloud Console and secure Firebase Rules.
# Leave these blank to use local-only authentication and browser scan history.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave false for local rules-only scanning. Set true only when the local proxy
# is running and GEMINI_API_KEY is set in .env.server.
VITE_GEMINI_ENABLED=false
